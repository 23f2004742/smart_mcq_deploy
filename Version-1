{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"competition","sourceId":143716}],"dockerImageVersionId":31400,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"# Smart MCQ Solver — DL & GenAI Project\n**Problem:** Given a question and 5 options (A–E), predict the top-3 most likely correct answers.  \n**Metric:** Mean Average Precision at 3 (MAP@3)  \n**Data:** 2000 train questions, 500 test questions across science, philosophy, and STEM domains.\n\n---\n\n### Approach (milestone-by-milestone)\n| Milestone | What we build |\n|-----------|--------------|\n| M1 | TF-IDF baseline with cosine similarity |\n| M2 | Sentence Transformers (pretrained BERT-based) + Zero-shot NLI |\n| M3 | RAG-style context retrieval and re-ranking |\n| M4 | MLP trained from scratch on similarity features |\n| M5 | Ensemble: combine all models, extract top-3 predictions |\n\nAll models are evaluated on a **clean train/validation split** (split by prompt group, zero leakage).  \nAll runs are tracked with **Weights & Biases**.","metadata":{"_uuid":"58d24d0a-2f31-4128-a80b-d9cf1bec1938","_cell_guid":"93e3a71d-7857-4bb2-b2cc-9767360ee071","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"markdown","source":"## 1. Setup","metadata":{"_uuid":"be031351-ce06-48b5-8edb-73a49ee204cd","_cell_guid":"b6434798-9d82-43d3-a50f-5879b9998884","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"# Kaggle already has most of these. Only wandb and sentence-transformers may need installing.\n!pip install -q wandb sentence-transformers\n\nimport os\nimport re\nimport json\nimport numpy as np\nimport pandas as pd\nimport wandb\nimport warnings\nwarnings.filterwarnings('ignore')\n\nfrom collections import Counter\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\nfrom sklearn.neural_network import MLPClassifier\nfrom sklearn.preprocessing import normalize\n\nprint(\"All imports done.\")\nprint(f\"Pandas  : {pd.__version__}\")\nprint(f\"NumPy   : {np.__version__}\")","metadata":{"_uuid":"4f35aac7-5ec0-4675-bcc4-11fa00c42704","_cell_guid":"d90713f7-15b3-4b05-9c90-1df62114aadb","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:38:10.292027Z","iopub.execute_input":"2026-07-02T08:38:10.292632Z","iopub.status.idle":"2026-07-02T08:38:17.153645Z","shell.execute_reply.started":"2026-07-02T08:38:10.292588Z","shell.execute_reply":"2026-07-02T08:38:17.1526Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from kaggle_secrets import UserSecretsClient\n\n# Reads the W&B API key you saved under Add-ons → Secrets → WANDB_API_KEY\n# You only need to do this once per session — all wandb.init() calls below\n# will pick up the login automatically.\nsecrets     = UserSecretsClient()\nWANDB_KEY   = secrets.get_secret(\"WandB_API_key\")\nwandb.login(key=WANDB_KEY, relogin=True)\nprint(\"Logged in to W&B ✓\")","metadata":{"_uuid":"08d7915b-f5af-4b6b-bee2-04887439fd42","_cell_guid":"390f1db9-a8da-41cb-a9a9-7fba5e59134b","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:38:17.155445Z","iopub.execute_input":"2026-07-02T08:38:17.155997Z","iopub.status.idle":"2026-07-02T08:38:25.423677Z","shell.execute_reply.started":"2026-07-02T08:38:17.155964Z","shell.execute_reply":"2026-07-02T08:38:25.422521Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"BASE        = '/kaggle/input/competitions/smart-mcq-solver-challenge'\nTRAIN_PATH  = f'{BASE}/train.csv'\nTEST_PATH   = f'{BASE}/test.csv'\nOUTPUT_PATH = '/kaggle/working/submission.csv'\n\nOPTIONS   = ['A', 'B', 'C', 'D', 'E']\nSEED      = 42\nVAL_SIZE  = 0.20\n\nWANDB_PROJECT = '23f2004742-t22026'","metadata":{"_uuid":"bba646e5-a21e-40eb-a729-b8fd37d9c366","_cell_guid":"521fb969-1e2a-4839-b6ce-d8e800651f9a","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:38:25.425822Z","iopub.execute_input":"2026-07-02T08:38:25.426324Z","iopub.status.idle":"2026-07-02T08:38:25.432036Z","shell.execute_reply.started":"2026-07-02T08:38:25.426293Z","shell.execute_reply":"2026-07-02T08:38:25.431024Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 2. Data Loading & Exploration","metadata":{"_uuid":"04b89c33-d9d8-4aa9-9ae2-8a490365db52","_cell_guid":"27655252-f902-4035-893a-c6596252af8f","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"train_df = pd.read_csv(TRAIN_PATH)\ntest_df  = pd.read_csv(TEST_PATH)\n\nprint(f\"Train : {train_df.shape[0]} rows, {train_df.shape[1]} columns\")\nprint(f\"Test  : {test_df.shape[0]} rows, {test_df.shape[1]} columns\")\nprint(f\"Columns: {list(train_df.columns)}\")\nprint()\nprint(\"Answer distribution in train:\")\nprint(train_df['answer'].value_counts().sort_index())\ntrain_df.head(3)","metadata":{"_uuid":"cb260502-e182-47eb-8223-7ba3e168e8a4","_cell_guid":"42dffcca-3ed1-4e40-b8bc-a0a80d4f647f","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:38:25.433278Z","iopub.execute_input":"2026-07-02T08:38:25.43359Z","iopub.status.idle":"2026-07-02T08:38:25.521645Z","shell.execute_reply.started":"2026-07-02T08:38:25.433562Z","shell.execute_reply":"2026-07-02T08:38:25.520649Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# A few observations before we model anything\n\n# 1. How long are the option texts?\nfor opt in OPTIONS:\n    lengths = train_df[opt].str.len()\n    print(f\"Option {opt} — mean: {lengths.mean():.0f}  max: {lengths.max()}\")\n\nprint()\n\n# 2. Duplicate prompts (same question appears multiple times with same/different options)\nprompt_counts = train_df['prompt'].value_counts()\nprint(f\"Unique prompts in train : {len(prompt_counts)}\")\nprint(f\"Prompts that appear >1x : {(prompt_counts > 1).sum()}\")\nprint()\n\n# 3. What kinds of questions are there?\ndef get_style(prompt):\n    p = prompt.lower()\n    if 'pick the best' in p:   return 'Pick the best'\n    if 'choose the correct' in p: return 'Choose the correct'\n    if 'which of the following' in p: return 'Which of the following'\n    return 'Other'\n\nstyles = train_df['prompt'].apply(get_style).value_counts()\nprint(\"Question styles:\")\nprint(styles)","metadata":{"_uuid":"35e24017-ac12-412d-9d73-9336e640244e","_cell_guid":"28276077-9649-44bd-83bc-0fc00cfe770f","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:38:25.522935Z","iopub.execute_input":"2026-07-02T08:38:25.523208Z","iopub.status.idle":"2026-07-02T08:38:25.545503Z","shell.execute_reply.started":"2026-07-02T08:38:25.523183Z","shell.execute_reply":"2026-07-02T08:38:25.544501Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 3. Train / Validation Split\n\nWe split **by prompt group** — all rows sharing the same prompt text go entirely into either\ntrain or validation. This prevents the model from seeing related questions during training\nand gives an honest performance estimate.","metadata":{"_uuid":"aea568ce-d376-4cbb-9138-2758c6428feb","_cell_guid":"fe506df3-c768-4bd9-89ae-54bcfbdf8f52","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"unique_prompts = train_df['prompt'].unique()\n\ntrain_prompts, val_prompts = train_test_split(\n    unique_prompts,\n    test_size=VAL_SIZE,\n    random_state=SEED\n)\n\ntrain_split = train_df[train_df['prompt'].isin(train_prompts)].reset_index(drop=True)\nval_split   = train_df[train_df['prompt'].isin(val_prompts)].reset_index(drop=True)\n\n# Sanity check: zero overlap\noverlap = set(train_split['prompt']) & set(val_split['prompt'])\nassert len(overlap) == 0, \"Data leakage detected!\"\n\nprint(f\"Train split : {len(train_split)} rows  ({len(train_split)/len(train_df)*100:.1f}%)\")\nprint(f\"Val split   : {len(val_split)} rows   ({len(val_split)/len(train_df)*100:.1f}%)\")\nprint(f\"Prompt overlap between splits: {len(overlap)}  ✓\")","metadata":{"_uuid":"2a6c3b5f-2806-45fa-980f-0b5c2504edab","_cell_guid":"c5d55051-dfe0-4206-818d-7fe195a50140","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:38:25.54847Z","iopub.execute_input":"2026-07-02T08:38:25.548853Z","iopub.status.idle":"2026-07-02T08:38:25.571264Z","shell.execute_reply.started":"2026-07-02T08:38:25.548822Z","shell.execute_reply":"2026-07-02T08:38:25.570156Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 4. Text Preprocessing","metadata":{"_uuid":"d82491a8-6bd3-42b8-ad15-c4f9037a2047","_cell_guid":"d85872ef-dc82-43eb-8d51-4321f87f89c0","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"def clean_text(text: str) -> str:\n    \"\"\"\n    Basic text cleaning applied to prompts and options.\n    - Strip leading/trailing whitespace\n    - Collapse multiple spaces into one\n    - Remove prompt boilerplate phrases that add no content\n    \"\"\"\n    text = str(text).strip()\n    text = re.sub(r'\\s+', ' ', text)\n    # Remove common boilerplate prefixes that appear in prompts\n    boilerplate = [\n        r'^Pick the best possible answer:\\s*',\n        r'^Choose the correct answer:\\s*',\n        r'^Select the most accurate option:\\s*',\n        r'^Identify the correct statement:\\s*',\n        r'^Determine the correct option:\\s*',\n        r'\\s*among the listed options\\.?$',\n        r'\\s*from the following choices\\.?$',\n        r'\\s*based on the given context\\.?$',\n        r'\\s*carefully\\.?$',\n    ]\n    for pattern in boilerplate:\n        text = re.sub(pattern, '', text, flags=re.IGNORECASE).strip()\n    return text\n\n\ndef preprocess_row(row: pd.Series) -> dict:\n    \"\"\"Clean the prompt and all five options for a single row.\"\"\"\n    return {\n        'prompt': clean_text(row['prompt']),\n        'A': clean_text(row['A']),\n        'B': clean_text(row['B']),\n        'C': clean_text(row['C']),\n        'D': clean_text(row['D']),\n        'E': clean_text(row['E']),\n    }\n\n\n# Apply to both splits and test set\ntrain_split = train_split.copy()\nval_split   = val_split.copy()\ntest_df_clean = test_df.copy()\n\nfor df in [train_split, val_split, test_df_clean]:\n    df['prompt'] = df['prompt'].apply(clean_text)\n    for opt in OPTIONS:\n        df[opt] = df[opt].apply(clean_text)\n\nprint(\"Preprocessing done.\")\nprint()\n# Show before/after for one example\nraw_prompt = train_df.iloc[0]['prompt']\nclean_prompt = train_split.iloc[0]['prompt']\nprint(f\"Before: {raw_prompt[:100]}\")\nprint(f\"After : {clean_prompt[:100]}\")","metadata":{"_uuid":"a30863e7-decd-4294-9b6f-6210dfd12dbb","_cell_guid":"7797b9a0-819b-44d4-91b7-8c312d62a673","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:38:25.572525Z","iopub.execute_input":"2026-07-02T08:38:25.572834Z","iopub.status.idle":"2026-07-02T08:38:26.204688Z","shell.execute_reply.started":"2026-07-02T08:38:25.572807Z","shell.execute_reply":"2026-07-02T08:38:26.203661Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 5. Evaluation Metric — MAP@3","metadata":{"_uuid":"5cc14dd5-8a2c-42e8-9a1e-74f6386142b0","_cell_guid":"f89ff8a2-b55b-4694-9147-8eb60f7623cd","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"def average_precision_at_3(actual: str, predicted: list) -> float:\n    \"\"\"\n    Compute Average Precision@3 for a single question.\n\n    Scoring logic:\n      - Predict up to 3 answers in ranked order.\n      - If the correct answer is at rank 1: score = 1/1 = 1.000\n      - If the correct answer is at rank 2: score = 1/2 = 0.500\n      - If the correct answer is at rank 3: score = 1/3 = 0.333\n      - If not in top 3: score = 0.000\n    \"\"\"\n    predicted = [str(p).strip().upper() for p in predicted[:3]]\n    for rank, pred in enumerate(predicted, start=1):\n        if pred == actual:\n            return 1.0 / rank\n    return 0.0\n\n\ndef map_at_3(actuals: list, predictions: list) -> float:\n    \"\"\"Average AP@3 across all questions.\"\"\"\n    assert len(actuals) == len(predictions)\n    scores = [average_precision_at_3(a, p) for a, p in zip(actuals, predictions)]\n    return float(np.mean(scores))\n\n\n# Quick unit tests\nassert average_precision_at_3('A', ['A', 'B', 'C']) == 1.000\nassert average_precision_at_3('A', ['B', 'A', 'C']) == 0.500\nassert abs(average_precision_at_3('A', ['C', 'D', 'A']) - 1/3) < 1e-9\nassert average_precision_at_3('A', ['B', 'C', 'D']) == 0.000\nprint(\"MAP@3 metric verified ✓\")","metadata":{"_uuid":"d80577f5-30a6-45b9-be8e-c041ed554ff4","_cell_guid":"cb6b59b1-f0ad-4dc3-9165-58007abbc2c8","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:38:26.205771Z","iopub.execute_input":"2026-07-02T08:38:26.206023Z","iopub.status.idle":"2026-07-02T08:38:26.21546Z","shell.execute_reply.started":"2026-07-02T08:38:26.206002Z","shell.execute_reply":"2026-07-02T08:38:26.214222Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 6. Milestone 1 — TF-IDF Baseline\n\n**Idea:** Build a TF-IDF index over `(prompt + correct option)` texts from training.  \nAt inference, score each of the 5 options by cosine similarity to this index and rank them.\n\n**Why this works:** Correct answers tend to contain specific, accurate terminology that\nappears in other correct answers from the training set. Distractors use similar-sounding\nbut incorrect phrases that score lower in the index.","metadata":{"_uuid":"67377d3c-ec9e-4a4e-a8d9-8d7469dbe19b","_cell_guid":"99a66c5b-b8a5-49a7-b9c1-0d5ed18e6bd3","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"# Build TF-IDF index on training data only\ncorrect_texts_train = [\n    f\"{row['prompt']} {row[row['answer']]}\"\n    for _, row in train_split.iterrows()\n]\n\ntfidf_vectorizer = TfidfVectorizer(\n    ngram_range=(1, 2),   # unigrams + bigrams\n    sublinear_tf=True,    # use log(tf) to reduce impact of very frequent words\n    max_features=80000,\n    strip_accents='unicode',\n    min_df=1\n)\ntfidf_matrix = tfidf_vectorizer.fit_transform(correct_texts_train)\n\nprint(f\"TF-IDF vocabulary size : {len(tfidf_vectorizer.vocabulary_)}\")\nprint(f\"TF-IDF matrix shape    : {tfidf_matrix.shape}  (train docs × vocab)\")","metadata":{"_uuid":"0ab8d802-9c27-423e-822a-c6700c9fcb6c","_cell_guid":"45b04b99-e63f-45c5-b247-ad94a5aea780","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:38:26.216901Z","iopub.execute_input":"2026-07-02T08:38:26.217284Z","iopub.status.idle":"2026-07-02T08:38:26.443632Z","shell.execute_reply.started":"2026-07-02T08:38:26.217246Z","shell.execute_reply":"2026-07-02T08:38:26.442629Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def tfidf_rank_options(row: pd.Series) -> list:\n    \"\"\"\n    Rank all 5 options by cosine similarity to the TF-IDF training corpus.\n    Returns option labels sorted from most to least likely correct.\n    \"\"\"\n    scores = {}\n    for opt in OPTIONS:\n        query = f\"{row['prompt']} {row[opt]}\"\n        query_vec = tfidf_vectorizer.transform([query])\n        # .max() = similarity to the single most similar training document\n        scores[opt] = float(cosine_similarity(query_vec, tfidf_matrix).max())\n    return sorted(scores, key=lambda o: -scores[o])\n\n\n# Evaluate on validation set\ntfidf_predictions = [tfidf_rank_options(row)[:3] for _, row in val_split.iterrows()]\ntfidf_map3 = map_at_3(val_split['answer'].tolist(), tfidf_predictions)\n\ntop1 = sum(p[0] == a for p, a in zip(tfidf_predictions, val_split['answer']))\nprint(f\"TF-IDF MAP@3       : {tfidf_map3:.4f}\")\nprint(f\"TF-IDF Top-1 Acc   : {top1}/{len(val_split)} = {top1/len(val_split):.2%}\")","metadata":{"_uuid":"d0ce60f5-f2f0-40e4-af70-780c387a1cf0","_cell_guid":"3dde1650-9d72-4394-b561-a8c1e064bc54","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:38:26.444861Z","iopub.execute_input":"2026-07-02T08:38:26.445133Z","iopub.status.idle":"2026-07-02T08:38:33.504486Z","shell.execute_reply.started":"2026-07-02T08:38:26.445108Z","shell.execute_reply":"2026-07-02T08:38:33.503489Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"wandb.init(\n    project=WANDB_PROJECT,\n    name=\"tfidf-baseline\",\n    config={\n        \"model\":        \"TF-IDF Cosine Similarity\",\n        \"ngram_range\":  \"(1,2)\",\n        \"max_features\": 80000,\n        \"sublinear_tf\": True,\n        \"val_size\":     VAL_SIZE,\n    },\n    reinit=True\n)\nwandb.log({\"val_map3\": tfidf_map3, \"val_top1_acc\": top1 / len(val_split)})\nwandb.finish()\nprint(\"TF-IDF run logged ✓\")","metadata":{"_uuid":"2f2ea4df-4f5e-4e0f-8780-db2a03afcd33","_cell_guid":"f2cccb24-21ae-442e-97b2-695566fe086a","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:38:33.5057Z","iopub.execute_input":"2026-07-02T08:38:33.506007Z","iopub.status.idle":"2026-07-02T08:38:42.812684Z","shell.execute_reply.started":"2026-07-02T08:38:33.505976Z","shell.execute_reply":"2026-07-02T08:38:42.811747Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 7. Milestone 2 — Sentence Transformers (Pretrained Model)\n\nTF-IDF works at the word level — if a test question uses different vocabulary than any\ntraining question, scores collapse. Sentence Transformers use a BERT-based encoder to\nproduce dense semantic embeddings that capture meaning, not just word overlap.\n\n**Model:** `all-MiniLM-L6-v2` — a lightweight but accurate sentence embedding model.  \n**Same idea:** embed `(prompt + option)`, find cosine similarity to correct training embeddings.","metadata":{"_uuid":"f920b02b-8ca5-40b7-b1b6-1ee04acea3ff","_cell_guid":"d367116d-add1-46d4-acd4-1cf0e81ffae1","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"from sentence_transformers import SentenceTransformer\n\nprint(\"Loading sentence transformer model...\")\nst_model = SentenceTransformer('all-MiniLM-L6-v2')\nprint(\"Model loaded.\")\nprint(f\"Embedding dimension: {st_model.get_sentence_embedding_dimension()}\")","metadata":{"_uuid":"d96cb76a-89ac-4265-92ab-272c9ca9b7cd","_cell_guid":"4197857f-2f22-456b-989d-0846e70a2919","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:38:42.814Z","iopub.execute_input":"2026-07-02T08:38:42.814602Z","iopub.status.idle":"2026-07-02T08:39:18.133922Z","shell.execute_reply.started":"2026-07-02T08:38:42.814561Z","shell.execute_reply":"2026-07-02T08:39:18.132857Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Encode the training corpus — one embedding per (prompt + correct option)\nprint(\"Encoding training corpus (this takes ~2-3 min on CPU, <30s on GPU)...\")\n\ntrain_corpus = [\n    f\"{row['prompt']} {row[row['answer']]}\"\n    for _, row in train_split.iterrows()\n]\ntrain_embeddings = st_model.encode(\n    train_corpus,\n    batch_size=64,\n    show_progress_bar=True,\n    convert_to_numpy=True\n)\n# L2-normalise so cosine similarity = dot product (faster at inference)\ntrain_embeddings = normalize(train_embeddings)\nprint(f\"\\nCorpus embeddings shape: {train_embeddings.shape}\")","metadata":{"_uuid":"1735ded4-37b0-48cb-abb1-1ae0bbd84e48","_cell_guid":"785fd2ec-00d9-460c-a069-c70600092f45","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:39:18.134965Z","iopub.execute_input":"2026-07-02T08:39:18.136564Z","iopub.status.idle":"2026-07-02T08:39:40.727567Z","shell.execute_reply.started":"2026-07-02T08:39:18.136528Z","shell.execute_reply":"2026-07-02T08:39:40.726478Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def st_rank_options(row: pd.Series) -> list:\n    \"\"\"\n    Rank all 5 options using sentence-transformer cosine similarity.\n    \"\"\"\n    option_texts = [f\"{row['prompt']} {row[opt]}\" for opt in OPTIONS]\n    option_embs  = st_model.encode(option_texts, convert_to_numpy=True)\n    option_embs  = normalize(option_embs)\n    # Max similarity to any training correct-answer embedding\n    sims = (option_embs @ train_embeddings.T).max(axis=1)\n    return [OPTIONS[i] for i in np.argsort(-sims)]\n\n\nprint(\"Evaluating on validation set...\")\nst_predictions = [st_rank_options(row)[:3] for _, row in val_split.iterrows()]\nst_map3 = map_at_3(val_split['answer'].tolist(), st_predictions)\n\ntop1_st = sum(p[0] == a for p, a in zip(st_predictions, val_split['answer']))\nprint(f\"Sentence Transformer MAP@3     : {st_map3:.4f}\")\nprint(f\"Sentence Transformer Top-1 Acc : {top1_st}/{len(val_split)} = {top1_st/len(val_split):.2%}\")","metadata":{"_uuid":"e009e341-aeb2-41bd-bc1c-4f9d4fbfa767","_cell_guid":"dfdcf22f-45c3-4fc6-9184-e97e5580590b","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:39:40.728924Z","iopub.execute_input":"2026-07-02T08:39:40.729227Z","iopub.status.idle":"2026-07-02T08:40:42.830233Z","shell.execute_reply.started":"2026-07-02T08:39:40.729198Z","shell.execute_reply":"2026-07-02T08:40:42.829478Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"wandb.init(\n    project=WANDB_PROJECT,\n    name=\"sentence-transformer\",\n    config={\n        \"model\":         \"all-MiniLM-L6-v2\",\n        \"embedding_dim\": st_model.get_sentence_embedding_dimension(),\n        \"similarity\":    \"cosine\",\n        \"val_size\":      VAL_SIZE,\n    },\n    reinit=True\n)\nwandb.log({\"val_map3\": st_map3, \"val_top1_acc\": top1_st / len(val_split)})\nwandb.finish()\nprint(\"Sentence Transformer run logged ✓\")","metadata":{"_uuid":"1cac22a5-2163-4243-925f-810885e4a013","_cell_guid":"6484d4c9-ae0b-426f-a43d-23c99e142f83","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:40:42.831199Z","iopub.execute_input":"2026-07-02T08:40:42.83498Z","iopub.status.idle":"2026-07-02T08:40:50.442238Z","shell.execute_reply.started":"2026-07-02T08:40:42.834931Z","shell.execute_reply":"2026-07-02T08:40:50.441151Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 8. Milestone 2 — Zero-shot Classification (NLI)\n\nAnother pretrained approach: frame each option as a candidate label for the question\nand use a Natural Language Inference (NLI) model to score the entailment probability.\n\n**Model:** `cross-encoder/nli-deberta-v3-small` — fast NLI cross-encoder.  \n**Framing:** hypothesis = option text, premise = question. Entailment score = option relevance.","metadata":{"_uuid":"efd49d2b-20d4-4719-9ee2-a9ec53ac363b","_cell_guid":"2265c728-7465-4246-8f8e-ea184773397b","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"from transformers import pipeline\n\nprint(\"Loading NLI zero-shot model...\")\nnli_pipeline = pipeline(\n    'zero-shot-classification',\n    model='cross-encoder/nli-deberta-v3-small',\n    device=0 if __import__('torch').cuda.is_available() else -1\n)\nprint(\"NLI model loaded.\")","metadata":{"_uuid":"4bce0ea9-dfa3-46ad-b5ec-cf3789df3e7b","_cell_guid":"7224e3a3-5652-4dee-9df5-dd5d393439cc","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:40:50.443667Z","iopub.execute_input":"2026-07-02T08:40:50.44412Z","iopub.status.idle":"2026-07-02T08:40:58.797835Z","shell.execute_reply.started":"2026-07-02T08:40:50.444075Z","shell.execute_reply":"2026-07-02T08:40:58.796575Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def nli_rank_options(row: pd.Series) -> list:\n    \"\"\"\n    Use zero-shot NLI to score each option against the prompt.\n    The model scores how well each option label 'entails' from the question.\n    \"\"\"\n    candidate_labels = [row[opt] for opt in OPTIONS]\n    result = nli_pipeline(\n        row['prompt'],\n        candidate_labels=candidate_labels,\n        multi_label=False\n    )\n    # Map scores back to option letters\n    label_to_opt = {row[opt]: opt for opt in OPTIONS}\n    ranked = [label_to_opt[label] for label in result['labels']]\n    return ranked\n\n\n# Evaluate on a sample first (NLI is slower, ~1-2s per question on CPU)\nprint(\"Evaluating NLI on validation set...\")\nprint(\"(On GPU this takes ~5 min; on CPU ~20 min. Reduce sample size if needed.)\")\n\nNLI_SAMPLE = len(val_split)   # set to e.g. 100 to test quickly\nval_sample  = val_split.iloc[:NLI_SAMPLE]\n\nnli_predictions = [nli_rank_options(row)[:3] for _, row in val_sample.iterrows()]\nnli_map3 = map_at_3(val_sample['answer'].tolist(), nli_predictions)\n\ntop1_nli = sum(p[0] == a for p, a in zip(nli_predictions, val_sample['answer']))\nprint(f\"Zero-shot NLI MAP@3     : {nli_map3:.4f}\")\nprint(f\"Zero-shot NLI Top-1 Acc : {top1_nli}/{len(val_sample)} = {top1_nli/len(val_sample):.2%}\")","metadata":{"_uuid":"09ef837a-6513-42d1-970a-683ec9b6e83f","_cell_guid":"ec68cc81-1c29-4389-9eaa-9d7b2cbe7956","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:40:58.799088Z","iopub.execute_input":"2026-07-02T08:40:58.799481Z","iopub.status.idle":"2026-07-02T08:45:32.636016Z","shell.execute_reply.started":"2026-07-02T08:40:58.799435Z","shell.execute_reply":"2026-07-02T08:45:32.634654Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"wandb.init(\n    project=WANDB_PROJECT,\n    name=\"zero-shot-nli\",\n    config={\n        \"model\":    \"cross-encoder/nli-deberta-v3-small\",\n        \"approach\": \"zero-shot classification\",\n        \"val_size\": VAL_SIZE,\n    },\n    reinit=True\n)\nwandb.log({\"val_map3\": nli_map3, \"val_top1_acc\": top1_nli / len(val_sample)})\nwandb.finish()\nprint(\"Zero-shot NLI run logged ✓\")","metadata":{"_uuid":"0a437dcc-2961-437b-9a45-ef8765fdcc29","_cell_guid":"a50e6225-7dfe-440a-af82-c06ec1358a66","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:45:32.637375Z","iopub.execute_input":"2026-07-02T08:45:32.637714Z","iopub.status.idle":"2026-07-02T08:45:40.29687Z","shell.execute_reply.started":"2026-07-02T08:45:32.637683Z","shell.execute_reply":"2026-07-02T08:45:40.295936Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 9. Milestone 3 — RAG-style Context Retrieval\n\nGeneral pretrained models sometimes lack domain-specific knowledge (e.g. advanced\nphysics, obscure philosophy). Retrieval-Augmented Generation addresses this by:\n\n1. **Retrieving** the most similar training questions to the current test question.\n2. **Augmenting** the similarity scoring with context from those retrieved examples.\n\nHere we use a lightweight dense retrieval: embed the question, find top-K nearest\nneighbours in the training set, and use their correct-answer texts as extra context\nwhen scoring the current options.","metadata":{"_uuid":"facf7f25-8312-4771-840a-bcb71e4b11a1","_cell_guid":"8c217a5e-10cb-469d-9220-8c9e5488f322","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"def build_rag_index(train_df: pd.DataFrame, encoder) -> tuple:\n    \"\"\"\n    Build a retrieval index over training prompts.\n    Returns (embeddings, list of correct option texts) for retrieval.\n    \"\"\"\n    prompts = train_df['prompt'].tolist()\n    correct = [row[row['answer']] for _, row in train_df.iterrows()]\n    prompt_embs = encoder.encode(prompts, batch_size=64, show_progress_bar=False,\n                                  convert_to_numpy=True)\n    prompt_embs = normalize(prompt_embs)\n    return prompt_embs, correct\n\n\nprint(\"Building RAG retrieval index over training prompts...\")\nrag_prompt_embs, rag_correct_texts = build_rag_index(train_split, st_model)\nprint(f\"Index built: {rag_prompt_embs.shape[0]} entries\")","metadata":{"_uuid":"eff44533-3802-4c6b-bd1b-f36cce67e5db","_cell_guid":"bdd18d23-2d09-4972-992f-48c4b8688bdc","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:45:40.29811Z","iopub.execute_input":"2026-07-02T08:45:40.298543Z","iopub.status.idle":"2026-07-02T08:45:47.740191Z","shell.execute_reply.started":"2026-07-02T08:45:40.298497Z","shell.execute_reply":"2026-07-02T08:45:47.739092Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def rag_rank_options(row: pd.Series, k: int = 5) -> list:\n    \"\"\"\n    RAG-style ranking:\n      1. Embed the question and retrieve top-K similar training questions.\n      2. Score each option against both the full training corpus AND the\n         retrieved context (average of both similarity scores).\n    \"\"\"\n    # Step 1: retrieve top-K similar training questions\n    q_emb = st_model.encode([row['prompt']], convert_to_numpy=True)\n    q_emb = normalize(q_emb)\n    retrieval_scores = (q_emb @ rag_prompt_embs.T)[0]\n    top_k_idx = np.argsort(-retrieval_scores)[:k]\n\n    # Step 2: embed the retrieved correct answers as extra context\n    context_texts = [rag_correct_texts[i] for i in top_k_idx]\n    context_embs  = st_model.encode(context_texts, convert_to_numpy=True)\n    context_embs  = normalize(context_embs)\n\n    # Step 3: score each option against both corpus and context\n    option_texts = [f\"{row['prompt']} {row[opt]}\" for opt in OPTIONS]\n    option_embs  = normalize(st_model.encode(option_texts, convert_to_numpy=True))\n\n    sim_corpus  = (option_embs @ train_embeddings.T).max(axis=1)\n    sim_context = (option_embs @ context_embs.T).max(axis=1)\n\n    # Combine: give slightly more weight to retrieved context\n    combined = 0.6 * sim_corpus + 0.4 * sim_context\n    return [OPTIONS[i] for i in np.argsort(-combined)]\n\n\nprint(\"Evaluating RAG on validation set...\")\nrag_predictions = [rag_rank_options(row)[:3] for _, row in val_split.iterrows()]\nrag_map3 = map_at_3(val_split['answer'].tolist(), rag_predictions)\n\ntop1_rag = sum(p[0] == a for p, a in zip(rag_predictions, val_split['answer']))\nprint(f\"RAG MAP@3       : {rag_map3:.4f}\")\nprint(f\"RAG Top-1 Acc   : {top1_rag}/{len(val_split)} = {top1_rag/len(val_split):.2%}\")","metadata":{"_uuid":"f1f44ff4-c467-40db-a3f7-6be4d6b5fd2c","_cell_guid":"f1adf5b3-e7bd-4e38-bb03-b15fd15a2466","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:45:47.7416Z","iopub.execute_input":"2026-07-02T08:45:47.741945Z","iopub.status.idle":"2026-07-02T08:47:23.180147Z","shell.execute_reply.started":"2026-07-02T08:45:47.741908Z","shell.execute_reply":"2026-07-02T08:47:23.17944Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"wandb.init(\n    project=WANDB_PROJECT,\n    name=\"rag-retrieval\",\n    config={\n        \"model\":           \"all-MiniLM-L6-v2\",\n        \"approach\":        \"RAG with top-5 retrieval\",\n        \"retrieval_k\":     5,\n        \"corpus_weight\":   0.6,\n        \"context_weight\":  0.4,\n        \"val_size\":        VAL_SIZE,\n    },\n    reinit=True\n)\nwandb.log({\"val_map3\": rag_map3, \"val_top1_acc\": top1_rag / len(val_split)})\nwandb.finish()\nprint(\"RAG run logged ✓\")","metadata":{"_uuid":"c50627b6-72b0-4e92-8d5d-c75d1f0252e0","_cell_guid":"b4fc5baa-94ab-4ad3-876a-9be612363cf3","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T08:47:23.184728Z","iopub.execute_input":"2026-07-02T08:47:23.185657Z","iopub.status.idle":"2026-07-02T08:47:30.877996Z","shell.execute_reply.started":"2026-07-02T08:47:23.185615Z","shell.execute_reply":"2026-07-02T08:47:30.876994Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 10. Milestone 4 — Model Built from Scratch (MLP)\n\nThe previous models all score options independently. This model learns to\n*compare* the 5 options jointly.\n\n**Input:** a feature vector of 15 values per question:\n- 5 TF-IDF cosine similarity scores (one per option)\n- 10 pairwise differences (score_i − score_j for all pairs)\n\n**Output:** probability distribution over 5 options.\n\n**Architecture:** 2-layer MLP implemented in pure NumPy — no sklearn, no PyTorch.  \nTraining uses mini-batch gradient descent with cross-entropy loss.","metadata":{"_uuid":"051b3355-07ac-4459-9c7b-4b555661e8bc","_cell_guid":"0b691bf9-2dc2-49f4-82b7-b9ff5c4050fe","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"# ── Feature extraction ────────────────────────────────────────────────────────\ndef extract_features(df: pd.DataFrame, vec, mat) -> tuple:\n    \"\"\"\n    For each question, compute a 15-dim feature vector:\n      - 5 TF-IDF cosine scores (one per option)\n      - 10 pairwise differences (s_i - s_j)\n    Returns X (n_questions × 15) and y (n_questions,) with correct option index 0-4.\n    \"\"\"\n    X, y = [], []\n    for _, row in df.iterrows():\n        sims = []\n        for opt in OPTIONS:\n            q = f\"{row['prompt']} {row[opt]}\"\n            v = vec.transform([q])\n            sims.append(float(cosine_similarity(v, mat).max()))\n\n        diffs = []\n        for i in range(5):\n            for j in range(i + 1, 5):\n                diffs.append(sims[i] - sims[j])\n\n        X.append(sims + diffs)\n        if 'answer' in df.columns:\n            y.append(OPTIONS.index(row['answer']))\n\n    return np.array(X, dtype=np.float32), np.array(y, dtype=np.int32)\n\n\nprint(\"Extracting features for train split...\")\nX_train, y_train = extract_features(train_split, tfidf_vectorizer, tfidf_matrix)\nprint(\"Extracting features for val split...\")\nX_val, y_val = extract_features(val_split, tfidf_vectorizer, tfidf_matrix)\n\nprint(f\"X_train : {X_train.shape}\")\nprint(f\"X_val   : {X_val.shape}\")","metadata":{"_uuid":"3e9e6a2f-d04c-4990-9b1a-501468d220c6","_cell_guid":"23c25d58-b5e9-4e28-8f27-93cee456a6ed","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T09:12:53.27488Z","iopub.execute_input":"2026-07-02T09:12:53.276189Z","iopub.status.idle":"2026-07-02T09:13:28.678216Z","shell.execute_reply.started":"2026-07-02T09:12:53.276147Z","shell.execute_reply":"2026-07-02T09:13:28.677255Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── MLP in pure NumPy ────────────────────────────────────────────────────────\nclass MLP:\n    \"\"\"\n    Two-layer MLP: Linear → ReLU → Linear → Softmax\n    Trained with mini-batch SGD and cross-entropy loss.\n    \"\"\"\n    def __init__(self, n_in, n_hidden, n_out, lr=0.05, seed=42):\n        rng = np.random.default_rng(seed)\n        scale = np.sqrt(2.0 / n_in)   # He initialisation for ReLU\n        self.W1 = rng.normal(0, scale, (n_in, n_hidden)).astype(np.float32)\n        self.b1 = np.zeros(n_hidden, dtype=np.float32)\n        self.W2 = rng.normal(0, np.sqrt(2.0 / n_hidden), (n_hidden, n_out)).astype(np.float32)\n        self.b2 = np.zeros(n_out, dtype=np.float32)\n        self.lr = lr\n\n    def _relu(self, x):\n        return np.maximum(0, x)\n\n    def _softmax(self, x):\n        ex = np.exp(x - x.max(axis=1, keepdims=True))\n        return ex / ex.sum(axis=1, keepdims=True)\n\n    def forward(self, X):\n        self.h1  = self._relu(X @ self.W1 + self.b1)\n        self.out = self._softmax(self.h1 @ self.W2 + self.b2)\n        return self.out\n\n    def backward(self, X, y_true):\n        n = len(X)\n        # Cross-entropy gradient w.r.t. softmax output\n        d_out = self.out.copy()\n        d_out[np.arange(n), y_true] -= 1\n        d_out /= n\n        # Layer 2 gradients\n        dW2 = self.h1.T @ d_out\n        db2 = d_out.sum(axis=0)\n        # Layer 1 gradients (ReLU derivative = 1 if h1 > 0)\n        d_h1 = (d_out @ self.W2.T) * (self.h1 > 0)\n        dW1  = X.T @ d_h1\n        db1  = d_h1.sum(axis=0)\n        # Update weights\n        self.W1 -= self.lr * dW1\n        self.b1 -= self.lr * db1\n        self.W2 -= self.lr * dW2\n        self.b2 -= self.lr * db2\n\n    def fit(self, X, y, epochs=300, batch_size=128, verbose=True):\n        history = []\n        n = len(X)\n        for epoch in range(1, epochs + 1):\n            idx = np.random.permutation(n)\n            epoch_loss = 0.0\n            for start in range(0, n, batch_size):\n                batch = idx[start:start + batch_size]\n                xb, yb = X[batch], y[batch]\n                probs = self.forward(xb)\n                loss  = -np.log(probs[np.arange(len(yb)), yb] + 1e-9).mean()\n                epoch_loss += loss * len(yb)\n                self.backward(xb, yb)\n            avg_loss = epoch_loss / n\n            history.append(avg_loss)\n            if verbose and epoch % 50 == 0:\n                print(f\"  Epoch {epoch:3d}/{epochs} — loss: {avg_loss:.4f}\")\n        return history\n\n    def predict_proba(self, X):\n        return self.forward(X)\n\n\n# ── Train ─────────────────────────────────────────────────────────────────────\nprint(\"Training MLP from scratch...\")\nmlp = MLP(n_in=15, n_hidden=64, n_out=5, lr=0.05, seed=SEED)\nhistory = mlp.fit(X_train, y_train, epochs=300, batch_size=128, verbose=True)","metadata":{"_uuid":"ed9abec9-ffcf-4b00-8f41-27f8bcca065f","_cell_guid":"45578aa3-8078-4b62-b5c6-ab0b398a33fd","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T09:13:28.680186Z","iopub.execute_input":"2026-07-02T09:13:28.680589Z","iopub.status.idle":"2026-07-02T09:13:29.424742Z","shell.execute_reply.started":"2026-07-02T09:13:28.680557Z","shell.execute_reply":"2026-07-02T09:13:29.423539Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Evaluate on validation set ────────────────────────────────────────────────\nproba_val = mlp.predict_proba(X_val)\nmlp_preds = [[OPTIONS[j] for j in np.argsort(-proba_val[i])][:3]\n             for i in range(len(X_val))]\nmlp_map3  = map_at_3(val_split['answer'].tolist(), mlp_preds)\ntop1_mlp  = sum(p[0] == OPTIONS[y_val[i]] for i, p in enumerate(mlp_preds))\n\nprint(f\"MLP (from scratch) MAP@3     : {mlp_map3:.4f}\")\nprint(f\"MLP (from scratch) Top-1 Acc : {top1_mlp}/{len(val_split)} = {top1_mlp/len(val_split):.2%}\")\n\n# ── Log to W&B ────────────────────────────────────────────────────────────────\nwandb.init(\n    project=WANDB_PROJECT,\n    name=\"mlp-from-scratch\",\n    config={\n        \"model\":        \"MLP (pure NumPy)\",\n        \"architecture\": \"15 → 64 → 5\",\n        \"features\":     \"TF-IDF sim scores + pairwise diffs\",\n        \"activation\":   \"ReLU + Softmax\",\n        \"optimizer\":    \"mini-batch SGD\",\n        \"epochs\":       300,\n        \"batch_size\":   128,\n        \"lr\":           0.05,\n        \"val_size\":     VAL_SIZE,\n    },\n    reinit=True\n)\nfor i, loss in enumerate(history, 1):\n    wandb.log({\"epoch\": i, \"train_loss\": loss})\nwandb.log({\"val_map3\": mlp_map3, \"val_top1_acc\": top1_mlp / len(val_split)})\nwandb.finish()\nprint(\"MLP run logged ✓\")","metadata":{"_uuid":"a3706400-111c-4d9b-b34b-c68d1652e26a","_cell_guid":"a48783cc-e693-4bdf-b89d-d683a944e254","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T09:13:29.425984Z","iopub.execute_input":"2026-07-02T09:13:29.426332Z","iopub.status.idle":"2026-07-02T09:13:36.953063Z","shell.execute_reply.started":"2026-07-02T09:13:29.426302Z","shell.execute_reply":"2026-07-02T09:13:36.951738Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 11. Milestone 5 — Ensemble\n\nWe combine all three ranking systems using **Borda count voting**:\n- Each model ranks the 5 options for a question (rank 1 = best).\n- Borda score: rank 1 → 5 points, rank 2 → 4 points, ..., rank 5 → 1 point.\n- Sum Borda scores across all models and pick top-3.\n\nThis is robust: if TF-IDF and ST both agree on rank-1, that option gets 10 points\nregardless of what the MLP says.","metadata":{"_uuid":"882fdd89-e7e4-4553-8500-3005667cccf5","_cell_guid":"9791128b-8c0f-425e-a715-e026a5a3d90b","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"def borda_ensemble(rankings: list) -> list:\n    \"\"\"\n    Combine multiple rankings using Borda count.\n    \n    rankings : list of lists, each a full ranking of OPTIONS\n    Returns  : options sorted from most to least votes\n    \"\"\"\n    n = len(OPTIONS)\n    scores = {opt: 0 for opt in OPTIONS}\n    for ranking in rankings:\n        for rank, opt in enumerate(ranking):\n            scores[opt] += (n - rank)   # rank 0 → n pts, rank 1 → n-1 pts, ...\n    return sorted(scores, key=lambda o: -scores[o])\n\n\ndef ensemble_rank(row: pd.Series,\n                  tfidf_weight: float = 1.0,\n                  st_weight: float    = 1.5,\n                  mlp_weight: float   = 1.0) -> list:\n    \"\"\"\n    Get a weighted Borda ensemble ranking for one question.\n    Weights determine how many times each model's ranking is counted.\n    \"\"\"\n    tfidf_r = tfidf_rank_options(row)\n    st_r    = st_rank_options(row)\n    \n    # MLP uses pre-computed features\n    sims = []\n    for opt in OPTIONS:\n        q = f\"{row['prompt']} {row[opt]}\"\n        v = tfidf_vectorizer.transform([q])\n        sims.append(float(cosine_similarity(v, tfidf_matrix).max()))\n    diffs = [sims[i] - sims[j] for i in range(5) for j in range(i+1, 5)]\n    x = np.array(sims + diffs, dtype=np.float32).reshape(1, -1)\n    proba = mlp.predict_proba(x)[0]\n    mlp_r = [OPTIONS[j] for j in np.argsort(-proba)]\n\n    # Repeat each ranking according to its weight (integer approximation)\n    all_rankings = (\n        [tfidf_r] * int(tfidf_weight * 2) +\n        [st_r]    * int(st_weight    * 2) +\n        [mlp_r]   * int(mlp_weight   * 2)\n    )\n    return borda_ensemble(all_rankings)\n\n\nprint(\"Evaluating ensemble on validation set...\")\nens_predictions = [ensemble_rank(row)[:3] for _, row in val_split.iterrows()]\nens_map3 = map_at_3(val_split['answer'].tolist(), ens_predictions)\n\ntop1_ens = sum(p[0] == a for p, a in zip(ens_predictions, val_split['answer']))\nprint(f\"Ensemble MAP@3       : {ens_map3:.4f}\")\nprint(f\"Ensemble Top-1 Acc   : {top1_ens}/{len(val_split)} = {top1_ens/len(val_split):.2%}\")","metadata":{"_uuid":"d8dffe2e-65bd-4373-ab0e-09aa3025a83b","_cell_guid":"fc56218a-e53b-4f6a-be0a-2c5738c0e0ce","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T09:13:36.955711Z","iopub.execute_input":"2026-07-02T09:13:36.956025Z","iopub.status.idle":"2026-07-02T09:14:45.904083Z","shell.execute_reply.started":"2026-07-02T09:13:36.955998Z","shell.execute_reply":"2026-07-02T09:14:45.902551Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"wandb.init(\n    project=WANDB_PROJECT,\n    name=\"borda-ensemble\",\n    config={\n        \"model\":      \"Borda Count Ensemble\",\n        \"components\": [\"TF-IDF\", \"SentenceTransformer\", \"MLP-scratch\"],\n        \"weights\":    {\"tfidf\": 1.0, \"st\": 1.5, \"mlp\": 1.0},\n        \"val_size\":   VAL_SIZE,\n    },\n    reinit=True\n)\nwandb.log({\"val_map3\": ens_map3, \"val_top1_acc\": top1_ens / len(val_split)})\nwandb.finish()\nprint(\"Ensemble run logged ✓\")","metadata":{"_uuid":"19a28406-592f-4d1d-aa6b-d6ef6b34a449","_cell_guid":"6ef653dc-6fd8-4fef-a14e-af276576ed91","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T09:14:45.905781Z","iopub.execute_input":"2026-07-02T09:14:45.906096Z","iopub.status.idle":"2026-07-02T09:14:56.333839Z","shell.execute_reply.started":"2026-07-02T09:14:45.906067Z","shell.execute_reply":"2026-07-02T09:14:56.332567Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 12. Model Comparison","metadata":{"_uuid":"cb5b8ead-7a58-4e4e-81d8-e0baad4f30ac","_cell_guid":"007baa7c-2a1c-4fd0-8dcc-7e6756a4a269","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"results = {\n    'TF-IDF Baseline    (M1)': tfidf_map3,\n    'Sentence Transformer(M2)': st_map3,\n    'Zero-shot NLI      (M2)': nli_map3,\n    'RAG Retrieval      (M3)': rag_map3,\n    'MLP from scratch   (M4)': mlp_map3,\n    'Borda Ensemble     (M5)': ens_map3,\n}\n\nprint(f\"{'Model':<35} {'MAP@3':>8}\")\nprint('-' * 45)\nfor name, score in results.items():\n    bar = '█' * int(score * 30)\n    print(f\"{name:<35} {score:>8.4f}  {bar}\")\n\nprint()\nbest_model = max(results, key=results.get)\nprint(f\"Best model: {best_model.strip()} with MAP@3 = {results[best_model]:.4f}\")","metadata":{"_uuid":"1b35d9ce-876f-4782-a280-5d55a6c66dde","_cell_guid":"9d2ff636-e4d7-408c-8a48-9a088cec8c3c","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T09:14:56.335471Z","iopub.execute_input":"2026-07-02T09:14:56.335833Z","iopub.status.idle":"2026-07-02T09:14:56.343582Z","shell.execute_reply.started":"2026-07-02T09:14:56.3358Z","shell.execute_reply":"2026-07-02T09:14:56.342598Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 13. Generate Submission","metadata":{"_uuid":"afc5b627-741b-4f27-ab00-7d7bed883742","_cell_guid":"8f030e89-c3fd-469c-b678-5f6d2deac393","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"# ── Retrain all models on the FULL training data ─────────────────────────────\n# Up to this point every model was trained on train_split (80% of train_df).\n# For the final submission we use all 2000 rows so the models see as much\n# data as possible. The test set is untouched until predict_test_row() below.\n\nprint(\"Retraining TF-IDF on full train_df...\")\nfull_correct_texts = [\n    f\"{row['prompt']} {row[row['answer']]}\"\n    for _, row in train_df.iterrows()\n]\ntfidf_vectorizer_full = TfidfVectorizer(\n    ngram_range=(1, 2), sublinear_tf=True,\n    max_features=80000, strip_accents=\"unicode\"\n)\ntfidf_matrix_full = tfidf_vectorizer_full.fit_transform(full_correct_texts)\n\nprint(\"Retraining Sentence Transformer corpus on full train_df...\")\ntrain_embeddings_full = normalize(\n    st_model.encode(\n        full_correct_texts, batch_size=64,\n        show_progress_bar=True, convert_to_numpy=True\n    )\n)\n\nprint(\"\\nExtracting features for full-data MLP...\")\nX_full, y_full = extract_features(train_df, tfidf_vectorizer_full, tfidf_matrix_full)\n\nprint(\"Training MLP on full data...\")\nmlp_full = MLP(n_in=15, n_hidden=64, n_out=5, lr=0.05, seed=SEED)\nmlp_full.fit(X_full, y_full, epochs=300, batch_size=128, verbose=False)\nprint(\"Done.\")","metadata":{"_uuid":"2cd10e32-6123-4fbd-811f-11adfaacaa43","_cell_guid":"5bb918d6-6a85-45c4-8a1b-af1a51305f6b","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T09:14:56.344885Z","iopub.execute_input":"2026-07-02T09:14:56.345377Z","iopub.status.idle":"2026-07-02T09:16:17.0961Z","shell.execute_reply.started":"2026-07-02T09:14:56.345346Z","shell.execute_reply":"2026-07-02T09:16:17.094881Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def predict_test_row(row: pd.Series) -> list:\n    # Ensemble prediction for one test row using full-data models.\n\n    # TF-IDF ranking\n    scores_tf = {}\n    for opt in OPTIONS:\n        q = f\"{row['prompt']} {row[opt]}\"\n        v = tfidf_vectorizer_full.transform([q])\n        scores_tf[opt] = float(cosine_similarity(v, tfidf_matrix_full).max())\n    tfidf_r = sorted(scores_tf, key=lambda o: -scores_tf[o])\n\n    # Sentence Transformer ranking\n    opt_texts = [f\"{row['prompt']} {row[opt]}\" for opt in OPTIONS]\n    opt_embs  = normalize(st_model.encode(opt_texts, convert_to_numpy=True, show_progress_bar=False))\n    sims_st   = (opt_embs @ train_embeddings_full.T).max(axis=1)\n    st_r      = [OPTIONS[i] for i in np.argsort(-sims_st)]\n\n    # MLP ranking\n    sims  = list(scores_tf.values())\n    diffs = [sims[i] - sims[j] for i in range(5) for j in range(i + 1, 5)]\n    x     = np.array(sims + diffs, dtype=np.float32).reshape(1, -1)\n    proba = mlp_full.predict_proba(x)[0]\n    mlp_r = [OPTIONS[j] for j in np.argsort(-proba)]\n\n    # Borda count: ST gets 3 votes, TF-IDF and MLP get 2 each\n    return borda_ensemble([tfidf_r] * 2 + [st_r] * 3 + [mlp_r] * 2)[:3]\n\n\nprint(\"Generating predictions for test set...\")\nrows = []\nfor i, (_, row) in enumerate(test_df_clean.iterrows()):\n    pred = predict_test_row(row)\n    rows.append({\"ID\": row[\"id\"], \"Prediction\": \" \".join(pred)})\n    if (i + 1) % 100 == 0:\n        print(f\"  {i + 1}/{len(test_df_clean)} done\")\n\nsubmission = pd.DataFrame(rows)\nsubmission.to_csv(OUTPUT_PATH, index=False)\nprint(f\"\\nSaved to {OUTPUT_PATH}\")\nprint(submission.head(10).to_string(index=False))","metadata":{"_uuid":"0e4f2c56-5571-41f7-bc42-7c85060e9cd0","_cell_guid":"c4af7182-7ecd-4567-9517-429152daa3f0","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T09:19:31.587022Z","iopub.execute_input":"2026-07-02T09:19:31.587671Z","iopub.status.idle":"2026-07-02T09:20:51.807961Z","shell.execute_reply.started":"2026-07-02T09:19:31.587631Z","shell.execute_reply":"2026-07-02T09:20:51.805573Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Check every row has exactly 3 unique valid labels\nerrors = []\nfor _, r in submission.iterrows():\n    parts = str(r[\"Prediction\"]).split()\n    if len(parts) != 3 or not all(p in OPTIONS for p in parts) or len(set(parts)) != 3:\n        errors.append(r[\"ID\"])\n\nif errors:\n    print(f\"Issues in {len(errors)} rows: {errors[:5]}\")\nelse:\n    print(f\"All {len(submission)} predictions are valid ✓\")\n    print(f\"IDs covered: {len(set(submission['ID']))} / {len(test_df)} ✓\")\n\n# Distribution of top-1 predictions\nprint(\"\\nTop-1 prediction distribution:\")\nprint(submission[\"Prediction\"].str.split().str[0].value_counts().sort_index())","metadata":{"_uuid":"1b923df2-0608-43b2-8ca9-962cfeac53b6","_cell_guid":"fc485d6e-868a-4cfa-9acc-93f278261cd2","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-07-02T09:21:11.106256Z","iopub.execute_input":"2026-07-02T09:21:11.106654Z","iopub.status.idle":"2026-07-02T09:21:11.147311Z","shell.execute_reply.started":"2026-07-02T09:21:11.106621Z","shell.execute_reply":"2026-07-02T09:21:11.146192Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null}]}